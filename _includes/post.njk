<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — Archive &amp; Attire</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<header>
  <div class="headbar">
    <a href="/index.html" class="brand-lockup">
      <img src="/assets/logo.png" alt="Archive &amp; Attire Editorial">
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="primary" id="primaryNav">
      <ul>
        <li><a href="/index.html">Home</a></li>
        <li><a href="/journal.html" class="active">Journal</a></li>
        <li><a href="/portfolio.html">Portfolio</a></li>
        <li><a href="mailto:archiveandattire.official@gmail.com">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<section class="hero" style="padding:64px 0 46px;">
  <div class="wrap">
    <span class="eyebrow">{{ category }}</span>
    <h1 style="font-size:38px;">{{ title }}</h1>
    <div class="byline-row" style="margin-top:18px;">
      <div class="byline">
        <span class="avatar">A</span>
        <span class="who">By <b>Archive &amp; Attire</b> &middot; {{ page.date.getFullYear() }}</span>
      </div>
    </div>
  </div>
</section>

<section class="journal-section">
  <div class="wrap" style="max-width:720px;">
    <div class="post-content" style="font-family:'EB Garamond', serif; font-size:18px; line-height:1.75;">
      {{ content | safe }}
    </div>
  </div>
</section>

<footer>
  <div class="footer-bottom">
    <span>&copy; {{ page.date.getFullYear() }} Archive &amp; Attire Editorial. All rights reserved.</span>
    <span>Designed with restraint.</span>
  </div>
</footer>

<script src="/nav.js"></script>
</body>
</html>
